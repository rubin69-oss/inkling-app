# Copy this file to .env.local and fill in your own keys.
# NEVER commit .env.local or share these keys with anyone.

# Get this from https://console.anthropic.com/settings/keys
# Used to read the book and identify characters (text only).
ANTHROPIC_API_KEY=sk-ant-...

# Get this from https://platform.openai.com/api-keys
# Used to generate the actual portrait images.
OPENAI_API_KEY=sk-...
